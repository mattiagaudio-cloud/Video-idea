  "lang": "it",
  "gap": 0.35
 },
 {
  "id": "l02",
  "text": "Lui è Marco.",
  "voice": "im_nicola",
  "speed": 0.9,
  "lang": "it",
  "gap": 0.7
 },
 {
  "id": "l03",
  "text": "Marco ha speso ottanta euro per GTA 6. Come tutti.",
