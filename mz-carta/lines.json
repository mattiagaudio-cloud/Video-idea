  "speed": 0.9,
  "lang": "it",
  "gap": 0.25
 },
 {
  "id": "l07",
  "text": "Come?",
  "voice": "im_nicola",
  "speed": 0.9,
  "lang": "it",
  "gap": 0.7
 },
 {
  "id": "l08",
  "text": "Ha aperto un conto Buddy con un codice amico: ottanta euro di benvenuto.",
