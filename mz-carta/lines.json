  "speed": 0.9,
  "lang": "it",
  "gap": 0.35
 },
 {
  "id": "l04",
  "text": "Lui invece è Luca.",
  "voice": "im_nicola",
  "speed": 0.9,
  "lang": "it",
  "gap": 0.6
 },
 {
  "id": "l05",
  "text": "Luca, GTA 6, l'ha preso gratis...",
  "voice": "im_nicola",
  "speed": 0.9,
  "lang": "it",
  "gap": 0.35
 },
 {
  "id": "l06",
